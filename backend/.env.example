# OpsPilot AI Configuration

# Environment Mode
DEMO_MODE=true
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Gemini API (Google GenAI)
GEMINI_API_KEY=

# Swytchcode Configuration
SWYTCHCODE_API_KEY=
SWYTCHCODE_BASE_URL=https://api.swytchcode.com/v1

# Service Specific Credentials (optional if using Swytchcode unified gateway)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

SLACK_BOT_TOKEN=
SLACK_CHANNEL_DEFAULT=#ops-alerts

JIRA_HOST=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=FIN

NOTION_API_KEY=
NOTION_DATABASE_ID=

# Agent Execution Limits
MAX_AGENT_STEPS=25
MAX_TOOL_RETRIES=3
TOOL_TIMEOUT_SECONDS=30
WORKFLOW_TIMEOUT_SECONDS=180

# Database
DATABASE_URL=sqlite:///./opspilot.db
